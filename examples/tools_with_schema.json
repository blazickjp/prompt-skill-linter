{
  "tools": {
    "get_weather": {
      "arguments": ["location", "units"],
      "required": ["location"],
      "schema": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string",
            "enum": ["celsius", "fahrenheit"]
          }
        },
        "required": ["location"],
        "additionalProperties": false
      },
      "capabilities": [
        "get current weather for a location"
      ]
    },
    "submit": {
      "arguments": ["nodes"],
      "required": ["nodes"],
      "capabilities": [
        "submit up to 10 nodes; returns exactly one task"
      ]
    },
    "poll": {
      "arguments": ["task_id"],
      "required": ["task_id"],
      "capabilities": [
        "poll exactly one task"
      ]
    }
  }
}
