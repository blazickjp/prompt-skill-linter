  "workflows": [
    {
      "id": "data-access-workflow",
      "advertisement_rule": "workflow-adv",
      "initial": ["start"],
      "goal": ["data_processed"],
      "actions": [
        {
          "id": "check_auth",
          "requires": ["start"],
          "adds": ["auth_checked"],
          "removes": []
