      "ordering_rules": [
        {
          "id": "auth-before-data",
          "kind": "before",
          "actions": ["grant_auth", "access_data"],
          "scope": {
            "entity": "agent",
            "temporal": "session"
          },
          "source": {
            "source_id": "policy",
            "start_line": 1,
