        {
          "id": "grant_auth",
          "requires": ["auth_checked"],
          "adds": ["authorized"],
          "removes": []
        },
        {
          "id": "skip_auth",
          "requires": ["start"],
          "adds": ["auth_skipped"],
          "removes": []
        },
        {
          "id": "access_data",
          "requires": ["start"],
          "adds": ["data_accessed"],
          "removes": [],
